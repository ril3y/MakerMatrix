# MakerMatrix Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ── Core Settings ─────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./makermatrix.db

# ── Data Paths ───────────────────────────────────────────────
# Default values are shown — override only if you run with custom mount points
# (the Docker image sets these to /data/* inside the container).
STATIC_FILES_PATH=./MakerMatrix/services/static
BACKUPS_PATH=./backups
CERTS_PATH=./certs

# Security (REQUIRED — change in production!)
JWT_SECRET_KEY=your-secure-secret-key-here-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
SERVER_HOST=localhost
# SERVER_PORT — used by DigiKey supplier to build OAuth callback URLs
# (MakerMatrix/suppliers/digikey.py). Defaults to HTTP_PORT/HTTPS_PORT based on
# HTTPS_ENABLED; uncomment to override.
# SERVER_PORT=8080

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,*

# Encryption Key for Credential Storage
# Rotating this invalidates every stored supplier credential — if you change it
# you must re-enter every supplier API key/secret through the UI.
MAKERMATRIX_ENCRYPTION_KEY=your_encryption_key_here

# MakerMatrix API Key (for testing/automation)
# Generate via: POST /api/api-keys/ (requires admin authentication)
MAKERMATRIX_API_KEY=

# ── Supplier API Keys (Optional) ─────────────────────────────
# DigiKey OAuth2
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Set to true for sandbox testing, false for production
DIGIKEY_CLIENT_SANDBOX=true

# Mouser
MOUSER_API_KEY=

# LCSC
LCSC_API_KEY=

# ── AI Configuration (Optional) ──────────────────────────────
# Ollama (local or Docker host)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ── HTTPS (Optional) ─────────────────────────────────────────
# Set to true for HTTPS mode (requires certs/ directory with valid SSL certificates)
HTTPS_ENABLED=false
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
HTTPS_PORT=8443

# HTTP
HTTP_PORT=8080
HTTP_REDIRECT_TO_HTTPS=true

# CORS Origins for HTTPS (uncomment and adjust if using HTTPS)
# CORS_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,http://localhost:8080

# DigiKey OAuth Callback for HTTPS (uncomment if using HTTPS)
# DIGIKEY_OAUTH_CALLBACK=https://localhost:8443/digikey_callback

# ── dev_manager.py Control API ───────────────────────────────
# These configure the HTTP control API exposed by the dev TUI (dev_manager.py)
# that lets local agents/scripts drive the dev backend + frontend. Safe to leave
# disabled in any non-development environment.
# Set to true to enable the local HTTP control API (default in code: true; set
# false here so a copied .env defaults to off in non-dev environments).
DEV_MANAGER_API_ENABLED=false
# Port for the dev_manager control API (binds 0.0.0.0; code default 8765).
DEV_MANAGER_API_PORT=8765
# Log every request handled by the dev_manager control API (code default true).
DEV_MANAGER_API_LOG_REQUESTS=true
